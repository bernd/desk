# shellcheck shell=bash
# Bash completion for ◲ desk

_desk() {
    PREFIX="${DESK_DIR:-$HOME/.desk}"
    DESKS="${DESK_DESKS_DIR:-$PREFIX/desks}"
    local completion

    cur=${COMP_WORDS[COMP_CWORD]}
    prev=${COMP_WORDS[COMP_CWORD-1]}

    case ${COMP_CWORD} in
        1)
            COMPREPLY=()
            while IFS= read -r completion; do
                COMPREPLY+=("$completion")
            done < <(compgen -W "edit . go run help init list ls version" -- "$cur")
            ;;
        2)
            case ${prev} in
                edit|go|.|run)
                    if [[ -d $DESKS ]]; then
                        local desks=$(desk list --only-names)
                    else
                        local desks=""
                    fi
                    COMPREPLY=()
                    while IFS= read -r completion; do
                        COMPREPLY+=("$completion")
                    done < <(compgen -W "${desks}" -- "$cur")
                    ;;
            esac
            ;;
        *)
            case ${COMP_WORDS[1]} in
                run)
                    # Complete arguments to the "run" command
                    _command_offset 3
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            ;;
    esac
}


complete -F _desk desk
